{
  "model": "opus",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/local.properties)",
      "Read(./**/keystore.properties)",

      "Edit(./.github/workflows/**)",
      "Edit(./**/CLAUDE.md)",
      "Edit(./.claude/rules/**)",
      "Edit(./.claude/agents/**)",
      "Edit(./CODEOWNERS)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./config/detekt/**)",
      "Edit(./.editorconfig)",

      "Bash(*CLAUDE.md*)",
      "Bash(*.claude*)",
      "Bash(*CODEOWNERS*)",
      "Bash(*.github/workflows*)",
      "Bash(*config/detekt*)",
      "Bash(*detekt.yml*)",
      "Bash(*.editorconfig*)",
      "Bash(*.env*)",
      "Bash(*secrets/*)",
      "Bash(*.jks*)",
      "Bash(*.keystore*)",
      "Bash(*keystore.properties*)",
      "Bash(*.p12*)",
      "Bash(*.pem*)",
      "Bash(*.key*)",
      "Bash(*local.properties*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * main:*)",
      "Bash(git push * +main*)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",

      "PowerShell(*CLAUDE.md*)",
      "PowerShell(*.claude*)",
      "PowerShell(*CODEOWNERS*)",
      "PowerShell(*workflows*)",
      "PowerShell(*detekt.yml*)",
      "PowerShell(*config?detekt*)",
      "PowerShell(*.editorconfig*)",
      "PowerShell(*.env*)",
      "PowerShell(*secrets*)",
      "PowerShell(*.jks*)",
      "PowerShell(*.keystore*)",
      "PowerShell(*keystore.properties*)",
      "PowerShell(*.p12*)",
      "PowerShell(*.pem*)",
      "PowerShell(*.key*)",
      "PowerShell(*local.properties*)",
      "PowerShell(git push)",
      "PowerShell(git push origin)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push * main:*)",
      "PowerShell(git push * +main*)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(git push *--all*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)"
    ]
  }
}
